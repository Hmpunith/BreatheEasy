{
  "name": "breathe-easy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "GenAI-powered Urban Air Quality Assistant for families and communities — Hack2Skill PromptWars Challenge 6",
  "author": "Hmpunith",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "node dist-server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@phosphor-icons/react": "^2.1.7",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lru-cache": "^11.1.0",
    "pino": "^9.6.0",
    "rate-limiter-flexible": "^5.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.14.0",
    "uuid": "^11.1.0",
    "valibot": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@tailwindcss/vite": "^4.1.8",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.13.0",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.27.0",
    "globals": "^16.0.0",
    "happy-dom": "^18.0.0",
    "prettier": "^3.5.3",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^8.3.6",
    "vitest": "^5.0.0"
  }
}
